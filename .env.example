# Interact AI Backend Configuration Template
# Copy this to .env or .env.dev and fill in your secrets.
# DO NOT COMMIT THE ACTUAL .env FILES TO GITHUB.

PORT=8000
DATABASE_URL=postgresql+asyncpg://user:password@localhost:5432/interact_db
REDIS_URL=redis://localhost:6379/0

# OpenRouter Configuration
OPENROUTER_API_KEY=your_sk_or_v1_key_here
OPENROUTER_MODEL=deepseek/deepseek-chat
OPENROUTER_REFERER=https://interact-ai.com
OPENROUTER_TITLE="Interact AI Platform"

# WhatsApp Configuration
WHATSAPP_VERIFY_TOKEN=your_secret_token
WHATSAPP_API_TOKEN=your_token
WHATSAPP_PHONE_NUMBER_ID=your_id

# Other
SECRET_KEY=your_django_or_fastapi_secret
ENV=development
